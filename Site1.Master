<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="E_Commerce_Platform_for_Spices.Site1" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#059669" />

    <title>FoodBridge – Connecting Donors with NGOs</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="CSS/style.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

<!-- ===== NAVBAR ===== -->
<nav class="navbar navbar-expand-lg sticky-top" id="mainNav">
    <div class="container">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" href="Default.aspx">
            <img src="Images/logo.png" alt="FoodBridge Logo" class="brand-logo" />
            <span class="brand-text">FoodBridge</span>
        </a>

        <!-- Links -->
        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav mx-auto">

                <li class="nav-item">
                    <a class="nav-link" id="navHome" href="Default.aspx">
                        <i class="bi bi-house-fill"></i> Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navAbout" href="About.aspx">
                        <i class="bi bi-info-circle-fill"></i> About
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navDonate" href="Donate.aspx">
                        <i class="bi bi-heart-fill"></i> Donate
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navNGOs" href="NGOs.aspx">
                        <i class="bi bi-people-fill"></i> NGOs
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navFAQ" href="FAQ.aspx">
                        <i class="bi bi-question-circle-fill"></i> FAQ
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navContact" href="Contact.aspx">
                        <i class="bi bi-telephone-fill"></i> Contact
                    </a>
                </li>

            </ul>

            <!-- Auth Buttons -->
            <div class="nav-auth-btns d-flex align-items-center gap-2">
                <% if (Session["UserId"] != null) { %>
                    <% if (Session["UserType"]?.ToString() == "Admin") { %>
                        <a href="Admin/Dashboard.aspx" class="btn-nav-outline" id="navAdmin">
                            <i class="bi bi-shield-fill"></i> Admin Panel
                        </a>
                    <% } %>
                    <span class="btn-nav-outline" style="cursor:default;">
                        <i class="bi bi-person-circle"></i> <%: Session["UserName"] %>
                    </span>
                    <a href="Logout.aspx" class="btn-nav-filled" id="navLogout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                <% } else { %>
                    <a href="Login.aspx" class="btn-nav-outline" id="navLogin">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    
                <% } %>
            </div>

        </div>
    </div>
</nav>

<!-- ===== PAGE CONTENT ===== -->
<asp:ContentPlaceHolder ID="MainContent" runat="server">
</asp:ContentPlaceHolder>

<!-- ===== FOOTER ===== -->
<footer class="site-footer">

    <div class="container">
        <div class="row g-4">

            <!-- Brand Col -->
            <div class="col-lg-4 col-md-6">
                <div class="footer-brand d-flex align-items-center gap-2">
                    <img src="Images/logo.png" alt="FoodBridge" class="footer-logo" />
                    <span class="footer-brand-name">FoodBridge</span>
                </div>
                <p class="footer-desc">
                    Connecting generous food donors with verified NGOs across Gujarat.
                    Together we fight hunger and reduce food waste, one meal at a time.
                </p>
           
            </div>

            <!-- Quick Links -->
            <div class="col-lg-2 col-md-3 col-6">
                <h5 class="footer-heading">Quick Links</h5>
                <ul class="footer-links">
                    <li><a href="Default.aspx"><i class="bi bi-chevron-right"></i> Home</a></li>
                    <li><a href="About.aspx"><i class="bi bi-chevron-right"></i> About Us</a></li>
                    <li><a href="Donate.aspx"><i class="bi bi-chevron-right"></i> Donate Food</a></li>
                    <li><a href="NGOs.aspx"><i class="bi bi-chevron-right"></i> NGOs</a></li>
                    <li><a href="FAQ.aspx"><i class="bi bi-chevron-right"></i> FAQ</a></li>
                    <li><a href="Contact.aspx"><i class="bi bi-chevron-right"></i> Contact</a></li>
                </ul>
            </div>

            <!-- For Donors -->
            <div class="col-lg-2 col-md-3 col-6">
                <h5 class="footer-heading">Get Involved</h5>
                <ul class="footer-links">
                    <li><a href="Register.aspx"><i class="bi bi-chevron-right"></i> Register</a></li>
                    <li><a href="Login.aspx"><i class="bi bi-chevron-right"></i> Login</a></li>
                    <li><a href="Donate.aspx"><i class="bi bi-chevron-right"></i> Donate Now</a></li>
                    <li><a href="NGOs.aspx"><i class="bi bi-chevron-right"></i> Partner NGO</a></li>
                    <li><a href="Contact.aspx"><i class="bi bi-chevron-right"></i> Volunteer</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="col-lg-4 col-md-6">
                <h5 class="footer-heading">Contact Us</h5>
                <div class="footer-contact-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>FoodBridge HQ, Satellite Road,<br />Ahmedabad, Gujarat – 380015</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-telephone-fill"></i>
                    <span>+91 9876543210</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-envelope-fill"></i>
                    <span>info@foodbridge.com</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-clock-fill"></i>
                    <span>Support: 7 AM – 10 PM daily</span>
                </div>
            </div>

        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p>© 2026 <strong>FoodBridge</strong> | All Rights Reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p>Made with <i class="bi bi-heart-fill text-danger"></i> in Gujarat, India</p>
                </div>
            </div>
        </div>

    </div>
</footer>

</form>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Active Nav Script -->
<script>
    (function () {
        var page = window.location.pathname.split('/').pop().toLowerCase();
        if (!page || page === '') page = 'default.aspx';

        var map = {
            'default.aspx': 'navHome',
            'about.aspx':   'navAbout',
            'donate.aspx':  'navDonate',
            'ngos.aspx':    'navNGOs',
            'faq.aspx':     'navFAQ',
            'contact.aspx': 'navContact'
        };

        var activeId = map[page];
        if (activeId) {
            var el = document.getElementById(activeId);
            if (el) el.classList.add('active');
        }
    })();
</script>

</body>
</html>